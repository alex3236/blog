{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "~/data/*": ["src/data/*"],
      "~/components/*": ["src/components/*"],
      "~/layouts/*": ["src/layouts/*"]
    }
  },
  "include": ["src/**/*", "astro.config.mjs", "scripts/**/*"]
}
