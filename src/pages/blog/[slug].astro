---
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('posts', p => !p.data.draft && !p.data.page)
  return posts.map(p => ({
    params: { slug: p.id },
  }))
}

const { slug } = Astro.params
return Astro.redirect(`/posts/${slug}`, 301)
