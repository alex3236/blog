---
import { siteMetadata } from '../data/siteMetadata'
import Travelling from './Travelling'
import RSSButton from './RSSButton'
import ThemeSwitch from './ThemeSwitch'

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '' || Astro.url.pathname.startsWith('/page/')
---

<header class="w-full pt-10">
  {
    isHome ? (
      <div>
        <a
          href="/"
          class="font-serif text-4xl leading-10 font-bold text-primary-600 lg:text-[2.6rem] dark:text-primary-300"
        >
          {siteMetadata.title}
        </a>
        <div class="flex flex-col justify-between py-2 pl-0.5 text-gray-600 sm:flex-row sm:items-center dark:text-gray-400">
          <p class="text-lg font-thin lg:text-xl">{siteMetadata.description}</p>
          <span class="flex gap-2 pt-4 sm:gap-3 sm:pt-0">
            <Travelling client:load />
            <RSSButton client:load />
            <ThemeSwitch client:load />
          </span>
        </div>
      </div>
    ) : (
      <div>
        <div class="float-right flex gap-2">
          <RSSButton client:load />
          <ThemeSwitch client:load />
        </div>
        <p class="text-gray-600 dark:text-gray-400">
          <a class="font-serif text-2xl font-bold text-primary-600 dark:text-primary-400" href="/">
            {siteMetadata.title}
          </a>
          <br class="md:hidden" />
          <span class="text-lg font-thin md:before:px-2 md:before:content-['•']">
            {siteMetadata.description}
          </span>
        </p>
      </div>
    )
  }
</header>
<hr class="my-4" />
